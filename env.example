# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# ── LLM ──────────────────────────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database backend switch ──────────────────────────────────────────
# "local"  -> uses the Docker Postgres started by docker-compose.yml
# "azure"  -> uses AZURE_DATABASE_URL below
DB_BACKEND=local

# Only needed if DB_BACKEND=azure
AZURE_DATABASE_URL=postgresql://user:password@your-server.postgres.database.azure.com:5432/eval_platform?sslmode=require

# ── Sandbox backend switch ───────────────────────────────────────────
# "local"  -> runs untrusted code in a local Docker container
# "azure"  -> runs it in Azure Container Instances (falls back to a
#             clear error message if Azure isn't reachable/configured)
SANDBOX_BACKEND=local

# ── Azure credentials (only needed if SANDBOX_BACKEND=azure) ────────
# These come from: az ad sp create-for-rbac --name eval-platform-sp ...
AZURE_SUBSCRIPTION_ID=your_subscription_id
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_service_principal_app_id
AZURE_CLIENT_SECRET=your_service_principal_password
AZURE_RESOURCE_GROUP=eval-platform-rg

# ── Azure Container Registry (only needed if SANDBOX_BACKEND=azure) ─
# These come from: az acr credential show --name <your-registry-name>
ACR_LOGIN_SERVER=yourregistry.azurecr.io
ACR_USERNAME=your_acr_username
ACR_PASSWORD=your_acr_password
